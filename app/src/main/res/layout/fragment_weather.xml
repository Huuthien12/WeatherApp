<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Main Weather Display -->
        <LinearLayout
            android:id="@+id/mainWeatherDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="80dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City Name"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/layoutPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgCurrentLocationMarker"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/location"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/viewCityDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/circle"
                    android:visibility="visible"
                    app:tint="#80FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:includeFontPadding="false"
                android:text="23°"
                android:textColor="#FFFFFF"
                android:textSize="120sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTempMinMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="28°/16°"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgWeatherIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/mainWeatherDisplay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mainWeatherDisplay" />

        <!-- 5-Day Forecast Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDailyForecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/mainWeatherDisplay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layoutDailyRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn5DayForecast"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_translucent"
                    android:text="5-day forecast"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 24-hour forecast -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHourlyForecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@+id/cardDailyForecast">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="24-hour forecast"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:alpha="0.7" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvForecast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="15dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@android:layout/simple_list_item_1" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <GridLayout
            android:id="@+id/detailsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@+id/cardHourlyForecast">

            <!-- UV Index -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/lblUV"
                    style="@style/WeatherDetailLabel"
                    android:text="UV"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvUV"
                    style="@style/WeatherDetailValue"
                    android:text="Moderate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblUV" />
                
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ProgressBar
                        android:id="@+id/pbUV"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progressDrawable="@drawable/circular_gauge_uv"
                        android:max="11"
                        android:progress="3" />
                    
                    <TextView
                        android:id="@+id/tvUVIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Humidity -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/lblHumidity"
                    style="@style/WeatherDetailLabel"
                    android:text="Humidity"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvHumidity"
                    style="@style/WeatherDetailValue"
                    android:text="48%"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblHumidity" />
                
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ProgressBar
                        android:id="@+id/pbHumidity"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progressDrawable="@drawable/circular_gauge_humidity"
                        android:max="100"
                        android:progress="48" />
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_humidity_drop"
                        app:tint="#00BAFF" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Real Feel -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/lblFeels"
                    style="@style/WeatherDetailLabel"
                    android:text="Real feel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvFeelsLike"
                    style="@style/WeatherDetailValue"
                    android:text="26°"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblFeels" />
                
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ProgressBar
                        android:id="@+id/pbFeels"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progressDrawable="@drawable/circular_gauge_feels"
                        android:max="50"
                        android:progress="26" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Wind -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/tvWindDirection"
                    style="@style/WeatherDetailLabel"
                    android:text="Southwest"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvWindSpeed"
                    style="@style/WeatherDetailValue"
                    android:text="7.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWindDirection" />

                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ImageView
                        android:id="@+id/imgCompassDial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_compass"
                        app:tint="#80FFFFFF" />

                    <ImageView
                        android:id="@+id/imgCompassArrow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_compass"
                        android:padding="12dp"
                        app:tint="#00BAFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="km/h"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:background="@drawable/bg_circle_blue"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="8dp" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Sunset -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/lblSunset"
                    style="@style/WeatherDetailLabel"
                    android:text="Sunset"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvSunset"
                    style="@style/WeatherDetailValue"
                    android:text="17:59"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblSunset" />
                
                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ProgressBar
                        android:id="@+id/pbSunset"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:progressDrawable="@drawable/gauge_sunset_arc"
                        android:max="100"
                        android:progress="70" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="05:29"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp"
                            android:gravity="start"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="17:59"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp"
                            android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pressure -->
            <androidx.constraintlayout.widget.ConstraintLayout
                style="@style/WeatherDetailCard"
                android:layout_columnWeight="1">
                <TextView
                    android:id="@+id/lblPressure"
                    style="@style/WeatherDetailLabel"
                    android:text="Pressure"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:id="@+id/tvPressure"
                    style="@style/WeatherDetailValue"
                    android:text="1015"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lblPressure" />
                
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    
                    <ProgressBar
                        android:id="@+id/pbPressure"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progressDrawable="@drawable/circular_gauge_pressure"
                        android:max="100"
                        android:progress="65" />
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/arrow_up_float"
                            app:tint="#00E5FF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="hPa"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>