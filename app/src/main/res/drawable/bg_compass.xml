<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vòng tròn bao ngoài -->
    <item>
        <shape android:shape="ring" android:thickness="1dp" android:useLevel="false">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <!-- Các vạch chia -->
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="ring" android:thickness="1dp" android:useLevel="false">
            <stroke android:width="1dp" android:color="#20FFFFFF" android:dashWidth="2dp" android:dashGap="4dp" />
        </shape>
    </item>
    <!-- Các hướng N, S, E, W -->
    <item>
        <bitmap android:src="@android:drawable/ic_menu_compass" android:alpha="0.2" />
    </item>
</layer-list>